# Postgres + PostGIS (see infra/docker-compose.yml; exposed on host port 55432)
DATABASE_URL=postgres://citywalk:citywalk@localhost:55432/citywalk

# 32+ random bytes, used to hash one-time codes and session tokens
AUTH_SECRET=replace-me-with-openssl-rand-hex-32

APP_URL=http://localhost:3000

# console: prints sign-in codes to the dev server log (never use in production)
# resend: sends real email, requires RESEND_API_KEY and MAIL_FROM
MAIL_TRANSPORT=console
# RESEND_API_KEY=
MAIL_FROM=CityWalk <hello@example.com>

# Optional MapLibre style URL. Defaults to the keyless OpenFreeMap dark style.
# NEXT_PUBLIC_MAP_STYLE_URL=
